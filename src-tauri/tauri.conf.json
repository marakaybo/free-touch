{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free Touch",
  "version": "0.1.1",
  "identifier": "io.github.marakaybo.freetouch",
  "build": {
    "devUrl": "http://localhost:5190",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Free Touch",
        "width": 1320,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0C0D11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "marakaybo",
    "shortDescription": "Free Touch",
    "longDescription": "Бесплатный пульт управления ПК с телефона",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQzk4NTEwRjdDQzFEMzgKUldRNEhjejNFSVhKLzEvaDVVQ0hGQlJhdkF5VGNjOUFvM0lDVm5kellpdkdRaHFzT3V5anhmdlAK",
      "endpoints": [
        "https://github.com/marakaybo/free-touch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}