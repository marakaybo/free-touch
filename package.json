{
  "name": "free-touch",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "npm run build:panel && vite",
    "build:panel": "vite build -c vite.panel.config.ts",
    "build:editor": "vite build",
