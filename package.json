    "dev:panel": "vite -c vite.panel.config.ts",
    "icons": "node scripts/make-icons.mjs && tauri icon assets/icon-1024.png",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "android": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
